{
  "expo": {
    "name": "Gamearn",
    "slug": "gamearn",
    "owner": "gamearn",
    "version": "2.0.26",
    "scheme": [
      "gamearn",
      "fb1762055368454928",
      "com.googleusercontent.apps.600025492198-eo1a768ea7ffh7m398fqu0d99ohc034f",
      "com.googleusercontent.apps.600025492198-2g641acpvmhl1bm0m3f535kcodvhmt8k",
      "com.gamearn"
    ],
    "orientation": "portrait",
    "icon": "./assets/logos/logo_dark.png",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gamearn",
      "infoPlist": {
        "NSCameraUsageDescription": "Gamearn uses the camera to update your profile photo.",
        "NSPhotoLibraryUsageDescription": "Gamearn accesses your photo library so you can set a profile photo."
      },
      "usesAppleSignIn": true,
      "buildNumber": "26"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logos/logo_dark.png",
        "backgroundColor": "#0A0E1A"
      },
      "package": "com.gamearn",
      "versionCode": 26,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/logos/logo_dark.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-web-browser",
      "expo-status-bar",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Gamearn accesses your photo library so you can set a profile photo.",
          "cameraPermission": "Gamearn uses the camera to update your profile photo."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/logos/logo_dark.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A0E1A"
        }
      ]
    ]
  }
}
