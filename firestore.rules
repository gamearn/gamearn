rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ───────────────────────────────────────────────────
    function isAuthed() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthed() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthed() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // ── Users ──────────────────────────────────────────────────────────────
    // Any authenticated user can read profiles (leaderboards, lobby names)
    // Only the owner can write their own profile
    match /users/{userId} {
      allow read:   if isAuthed();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // ── User sub-collections (followers/following) ────────────────────────
    match /users/{userId}/followers/{followerId} {
      allow read: if isAuthed();
      allow write: if isOwner(userId) || isOwner(followerId);
    }
    match /users/{userId}/following/{followingId} {
      allow read: if isAuthed();
      allow write: if isOwner(userId) || isOwner(followingId);
    }

    // ── Wallets ────────────────────────────────────────────────────────────
    // Strictly private — only the owner can read or write their own wallet
    match /wallets/{userId} {
      allow read:   if isOwner(userId);
      allow update: if isOwner(userId);
      allow create: if isOwner(userId);
      allow delete: if false;

      // Wallet transactions sub-collection
      match /transactions/{txId} {
        allow read:   if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if false; // transactions are immutable
        allow delete: if false;
      }
    }

    // ── Tournaments ────────────────────────────────────────────────────────
    // Any authenticated user can read tournaments
    // Only admins can create or delete
    // Update restricted to creator (join/leave) or admin
    match /tournaments/{tournamentId} {
      allow read:   if isAuthed();
      allow create: if isAdmin();
      allow update: if isAuthed() && (
        resource.data.createdBy == request.auth.uid || isAdmin()
      );
      allow delete: if isAdmin();

      // ── Lobby sub-collection ─────────────────────────────────────────────
      match /lobby/{userId} {
        allow read:   if isAuthed();
        allow create: if isOwner(userId);
        allow delete: if isOwner(userId);
        allow update: if false;
      }
    }

    // ── Leaderboard ────────────────────────────────────────────────────────
    // Read-only for authenticated users, written by Cloud Functions / Admin SDK only
    match /leaderboard/{uid} {
      allow read:  if isAuthed();
      allow write: if false;
    }

    // ── Arena (games catalogue) ────────────────────────────────────────────
    match /arena/{gameId} {
      allow read:  if isAuthed();
      allow write: if false;
    }

    // ── Notifications (flat collection) ───────────────────────────────────
    // Users can only read/mark their own notifications
    match /notifications/{notifId} {
      allow read:   if isAuthed() && resource.data.userId == request.auth.uid;
      allow create: if false; // written by Cloud Functions / Admin SDK only
      allow update: if isAuthed() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthed() && resource.data.userId == request.auth.uid;
    }

    // ── Withdrawal Requests ───────────────────────────────────────────────
    match /withdrawal_requests/{requestId} {
      allow create: if isAuthed() && request.data.userId == request.auth.uid;
      allow read:   if isAuthed() && resource.data.userId == request.auth.uid;
      allow update: if false; // admin only via Admin SDK
      allow delete: if false;
    }

    // ── Daily Streaks ─────────────────────────────────────────────────────
    match /daily_streaks/{userId} {
      allow read:  if isOwner(userId);
      allow write: if false; // server-side only (Cloud Functions)
    }

    // ── Premium Subscriptions ─────────────────────────────────────────────
    match /premium_subscriptions/{userId} {
      allow read:  if isOwner(userId);
      allow write: if false; // server-side only
    }

    // ── Coin Packages ─────────────────────────────────────────────────────
    match /coin_packages/{packageId} {
      allow read:  if isAuthed();
      allow write: if false; // admin only via Admin SDK
    }

    // ── Game Sessions ─────────────────────────────────────────────────────
    match /game_sessions/{sessionId} {
      allow read:  if isAuthed();
      allow write: if false; // server-side only
    }

    // ── Challenges ────────────────────────────────────────────────────────
    match /challenges/{challengeId} {
      allow read: if isAuthed() && (
        resource.data.challengerUid == request.auth.uid ||
        resource.data.opponentUid == request.auth.uid
      );
      allow create: if isAuthed();
      allow update: if isAuthed() && (
        resource.data.challengerUid == request.auth.uid ||
        resource.data.opponentUid == request.auth.uid
      );
      allow delete: if false;
    }

    // ── Catch-all: deny everything not explicitly matched ──────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
