{
  "name": "gamearn",
  "version": "2.0.27",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "dev": "expo start --web",
    "postinstall": "patch-package && node -e \"const p='node_modules/expo-modules-core/package.json'; try { const fs=require('fs'); const j=JSON.parse(fs.readFileSync(p)); if(j.main==='src/index.ts'){j.main='index.js'; fs.writeFileSync(p, JSON.stringify(j,null,2));} } catch(e){}\""
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "^26.4.0",
    "@react-native-firebase/auth": "^26.4.0",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.10.1",
    "expo": "~54.0.0",
    "expo-apple-authentication": "~8.0.8",
    "expo-asset": "~12.0.13",
    "expo-auth-session": "~7.0.11",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-font": "~14.0.12",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-modules-core": "~3.0.30",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.20",
    "expo-web-browser": "~15.0.11",
    "firebase": "^12.19.0",
    "lucide-react-native": "^1.47.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-get-random-values": "~1.11.0",
    "react-native-google-mobile-ads": "17.0.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-react": "^7.20.0",
    "@expo/cli": "~54.0.27",
    "babel-plugin-react-native-web": "^0.19.0",
    "babel-preset-expo": "~54.0.0",
    "denodeify": "^1.2.1",
    "metro": "~0.81.0",
    "metro-config": "~0.81.0",
    "patch-package": "^8.0.1"
  },
  "expo": {
    "autolinking": {
      "exclude": [
        "@expo/dom-webview"
      ]
    }
  },
  "react-native": {
    "dependencies": {
      "@expo/dom-webview": {
        "platforms": {
          "android": null,
          "ios": null
        }
      }
    }
  },
  "private": true
}
