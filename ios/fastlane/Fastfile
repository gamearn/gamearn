# Fastfile — iOS archive + export (App Store) and TestFlight upload.
#
# Requires CI secrets:
#   - MATCH_REPO, MATCH_PASSWORD, MATCH_GIT_BASIC_AUTHORIZATION (signing)
#   - TEAM_ID (Apple Developer Team ID)  -> used for export
#   - APP_STORE_CONNECT_API_KEY_* (App Store Connect API key) for TestFlight
#
# Assumes the Flutter iOS project has been prepared with `flutter pub get`
# (which generates ios/Podfile + Runner.xcworkspace via pod install).

fastlane_version "2.220.0"

default_platform(:ios)

platform :ios do
  desc "Set up CI keychain + sync signing assets via match (API-key provisioned)"
  lane :sync_signing do
    setup_ci   # creates + unlocks a temp keychain; fixes errSecInternalComponent
    team_id = ENV["TEAM_ID"]
    UI.user_error!("TEAM_ID is not set.") if team_id.nil? || team_id.empty?

    match(
      type: "appstore",
      app_identifier: "com.gamearn",
      readonly: false,
      team_id: team_id,
      # Authenticate provisioning via the App Store Connect API key in env,
      # so no Apple ID username/password prompt is needed in CI.
      api_key: app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
        key_content: ENV["APP_STORE_CONNECT_API_KEY_BASE64"],
        is_key_content_base64: true,
        duration: 1200,
        in_house: false,
      ),
    )
  end

  desc "Build & export an App Store IPA (signed via match)"
  lane :build_ipa do
    team_id = ENV["TEAM_ID"]
    UI.user_error!("TEAM_ID is not set.") if team_id.nil? || team_id.empty?

    # Archive + export using the App Store export method. The Flutter workspace
    # (Runner.xcworkspace) is generated by `flutter build ios --no-codesign`,
    # which the CI workflow runs before this lane.
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      output_directory: "build/ios/ipa",
      output_name: "Gamearn",
      export_team_id: team_id,
      skip_archive: false,
      clean: true,
      derived_data_path: "build/ios/DerivedData",
    )

    ipa = Dir["build/ios/ipa/*.ipa"].first
    UI.user_error!("No .ipa was produced — build failed.") if ipa.nil?
    UI.success "IPA ready: #{ipa}"
  end

  desc "Upload the App Store IPA to TestFlight"
  lane :upload_testflight do
    ipa = Dir["build/ios/ipa/*.ipa"].first
    UI.user_error!("No .ipa found to upload.") if ipa.nil?

    upload_to_testflight(
      ipa: ipa,
      skip_waiting_for_build_processing: true,
    )
  end
end
