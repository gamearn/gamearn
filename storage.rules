rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Avatar / profile-picture pipeline — Direct-to-Firebase, zero server overhead
// ─────────────────────────────────────────────────────────────────────────────
// The Node.js API server processes zero image traffic. Uploads flow straight
// from the Flutter client to Firebase Storage.
//
// The 24h / one-per-day limit is a server-side state machine:
//   1. The authoritative cooldown record lives in Firestore at
//      upload_cooldowns/{userId}.lastProfileUpload.
//   2. Clients CANNOT write that record (firestore.rules denies it).
//   3. The Cloud Function `enforceAvatarCooldown` writes it on every Storage
//      finalize, so it is recorded even if the client disconnects or never
//      confirms — a malicious client cannot skip or fake it.
//   4. These rules read that record (firestore.get) at upload time to gate the
//      write. The very first upload (no record yet) is always allowed.
//
// Only the profile-picture path (users/{userId}/profile.jpg) is client-
// writable here. All other paths stay readable (legacy avatar URLs, bundled
// covers, etc.) but are NOT writable by clients.
//
// Requires the Blaze plan: firestore.get/exists in Storage rules and Cloud
// Functions are not available on the Spark plan.
// ─────────────────────────────────────────────────────────────────────────────

service firebase.storage {
  match /b/{bucket}/o {

    // Explicit targeting of the profile-pictures path structure
    match /users/{userId}/profile.jpg {

      // Global Read Permission: anyone interacting with the app can view the
      // avatar. Egress is protected by aggressive client-side caching
      // (cached_network_image / ProductionCachedAvatarWidget) which keeps
      // repeat lookups on local mobile storage.
      allow read: if true;

      // Server-authoritative cooldown record (written only by the Cloud
      // Function via the Admin SDK — clients cannot touch it). Note: Storage
      // rules do NOT support `let` variables, so the path is inlined below.
      // path: /databases/(default)/documents/upload_cooldowns/$(userId)

      // Meticulous Write Protection (Create, Update):
      //   Rule 1: authenticated request
      //   Rule 2: strict ownership (only the owner's own directory)
      //   Rule 3: payload cap (under 150 KB)
      //   Rule 4: distributed 24-hour cooldown vs. the server-stamped record
      allow create, update: if
        request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 150 * 1024
        && (
          // Case A: never uploaded before (no cooldown record exists)
          !firestore.exists(
              /databases/(default)/documents/upload_cooldowns/$(userId))
          // Case B: record exists but carries no timestamp yet
          || firestore.get(
                 /databases/(default)/documents/upload_cooldowns/$(userId))
              .data.lastProfileUpload == null
          // Case C: now is past the last upload + 24 hours
          || request.time >
             firestore.get(
                 /databases/(default)/documents/upload_cooldowns/$(userId))
                 .data.lastProfileUpload
             + duration.value(24, 'h')
        );

      // Delete: owner may remove their own picture at any time.
      // `request.resource` does not exist on delete, so it is excluded here —
      // a combined `allow write` would silently deny every delete.
      allow delete: if
        request.auth != null
        && request.auth.uid == userId;
    }

    // Everything else: readable (preserves legacy `avatars/*` URLs and any
    // existing media reads), but never client-writable.
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
